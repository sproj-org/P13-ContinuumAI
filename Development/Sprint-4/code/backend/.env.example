# Server
ENV=development
HOST=0.0.0.0
PORT=8000
DEMO_MODE=1
ENABLE_DEBUG=0

# OpenAI
OPENAI_API_KEY=your_openai_key_here
VIZAGENT_MODEL=your_model_here
OPENAI_MODEL=gpt-4o-mini

# Database (placeholder)
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME

# JWT
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS (placeholder)
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Minimal alerts (event-hook primary + daily backup scheduler)
# CI/CD deploy usage (run these from Development/Sprint-4/code/backend on the deployment Windows host):
# powershell -ExecutionPolicy Bypass -File scripts/setup_minimal_alert_backup_daily.ps1 -DatasetId silkroute -Time 09:00
# python scripts/run_minimal_alert_event_hook.py --dataset-id silkroute --source strategy_recompute --monitor-log out/alerts_monitor.jsonl
ALERTS_ENABLED=1
ALERT_STATE_FILE=out/alerts_state.json
# Optional rollout defaults for CI/scheduler wrappers (documented values)
ALERT_MONITOR_LOG=out/alerts_monitor.jsonl
ALERT_DEFAULT_DATASET_ID=silkroute
ALERT_EVENT_SOURCE=strategy_recompute
ALERT_EMAIL_TO=ops@example.com
ALERT_EMAIL_FROM=continuum-alerts@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com#you only need to add gmail and password to this
SMTP_PASSWORD=your_16_char_gmail_app_password(go to https://myaccount.google.com/apppasswords to create one)
SMTP_USE_TLS=1
